import opendbc

import os
env = Environment(
  ENV=os.environ,
  CFLAGS=[
    '-nostdlib',
    '-fno-builtin',
    '-std=gnu11',
    '-Wfatal-errors',
    '-Wno-pointer-to-int-cast',
  ],
  CPPPATH=[".", "../../", "../../board/", opendbc.INCLUDE_PATH],
)

panda = env.SharedObject("panda.os", "panda.c")
libpanda = env.SharedLibrary("libpanda.so", [panda])

f4_env = env.Clone()
f4_env.Append(CPPDEFINES=['TEST_STM32F4'])
f4 = f4_env.SharedObject("panda_f4.os", "panda.c")
f4_env.SharedLibrary("libpanda_f4.so", [f4])
