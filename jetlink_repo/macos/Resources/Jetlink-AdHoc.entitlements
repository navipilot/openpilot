<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jetlink.entitlements for an ad hoc signature (Debug builds, and sign.sh with
  SIGN_IDENTITY "-"): the hardened runtime's library validation loads Sparkle
  only when it shares the app's Team ID, and an ad hoc signature has none.
  Keep the rest in step with Jetlink.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
