// Signing for Jetlink for iPhone. The committed values build for no one in
// particular; your own team and bundle identifier go in Local.xcconfig beside
// this file, which git ignores (copy Local.xcconfig.example). Set them there
// rather than in Xcode's Signing & Capabilities, which would write them into
// the committed project file.

DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = io.zoompilot.jetlink

#include? "Local.xcconfig"
