# A Linux laptop or desktop serving as the USB host needs to open the comma's
# gadget without root. The server opens it through usbfs, so this is the whole
# driver.
#   sudo install -m 644 scripts/99-jetlink-host.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=usb
# 1209:0001 is the pid.codes test allocation the comma's gadget presents.
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="0001", MODE="0666", TAG+="uaccess"
# The comma's network interface (for a Linux host standing in for a phone, or
# a PC on the cable network): the 4.9 gadget kernel sends 16 KB NCM blocks at
# 22 Mbit/s and 2 KB blocks at 190 Mbit/s, so cap the block size on plug-in.
SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", RUN+="/bin/sh -c 'echo 2048 > /sys/class/net/%k/cdc_ncm/rx_max'"
