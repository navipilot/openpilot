Import('env', 'arch', 'messaging', 'common', 'visionipc')

libs = [common, messaging, visionipc]

if arch != "Darwin":
  # Qualcomm ioctl initializers use Clang extensions, including on host regression builds.
  camera_env = env.Clone(CC='clang', CXX='clang++')
  camera_obj = camera_env.Object(['cameras/camera_qcom2.cc', 'cameras/camera_common.cc', 'cameras/spectra.cc',
                                  'cameras/cdm.cc', 'sensors/ar0231.cc', 'sensors/ox03c10.cc', 'sensors/os04c10.cc'])
  camera_env.Program('camerad', ['main.cc', camera_obj], LIBS=libs)

  if GetOption('extras') or 'openpilot/system/camerad/test/test_sensors' in BUILD_TARGETS:
    camera_env.Program('test/test_sensors', ['test/test_sensors.cc', camera_obj], LIBS=libs)
